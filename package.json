{
  "name": "avp-joao-turano-2ati",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de catálogo de animes com Express e Prisma",
  "main": "avp-joao-turano-2ati/server.js",
  "scripts": {
    "start": "tsx avp-joao-turano-2ati/server.js",
    "dev": "tsx watch avp-joao-turano-2ati/server.js",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2"
  }
}
